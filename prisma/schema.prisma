// This is your Prisma schema file - SQLite version for local development
// For production use PostgreSQL by changing provider to "postgresql"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts             Account[]
  sessions             Session[]
  journeys             Journey[]
  communityReports     CommunityReport[]
  reportConfirmations  ReportConfirmation[]
  comments             Comment[]
  reportVotes          ReportVote[]
  savedJourneys        SavedJourney[]
}

model Journey {
  id                String   @id @default(cuid())
  userId            String?
  origin            String
  destination       String
  originLat         Float
  originLng         Float
  destinationLat    Float
  destinationLng    Float
  travelDate        DateTime
  travelMode        String   @default("DRIVING")
  status            String   @default("ANALYZING")
  preferences       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lastAnalyzedAt    DateTime?

  user              User?            @relation(fields: [userId], references: [id])
  routes            Route[]
  analysis          JourneyAnalysis?
  hazards           Hazard[]
  communityReports  CommunityReport[]
  dataSourceRecords DataSourceRecord[]
  savedBy           SavedJourney[]
}

model Route {
  id              String   @id @default(cuid())
  journeyId       String
  providerRouteId String?
  distance        Float
  duration        Int
  geometry        String   // JSON stored as string for SQLite
  isPrimary       Boolean  @default(false)
  riskLevel       String   @default("LOW")
  summary         String?
  waypoints       String?  // JSON stored as string for SQLite
  createdAt       DateTime @default(now())

  journey         Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  hazards         Hazard[]
  segments        RouteSegment[]
}

model RouteSegment {
  id            String   @id @default(cuid())
  routeId       String
  name          String
  startLat      Float
  startLng      Float
  endLat        Float
  endLng        Float
  condition     String   @default("UNKNOWN")
  riskLevel     String   @default("LOW")
  averageSpeed  Float?
  isBlocked     Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  route         Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  hazards       Hazard[]
}

model JourneyAnalysis {
  id               String    @id @default(cuid())
  journeyId        String    @unique
  overallRisk      String
  summary          String
  recommendation   String
  confidence       Float
  riskFactors      String    // JSON stored as string for SQLite
  aiRawResponse    String?
  generatedAt      DateTime  @default(now())
  expiresAt        DateTime

  journey          Journey   @relation(fields: [journeyId], references: [id], onDelete: Cascade)
}

model Hazard {
  id                String   @id @default(cuid())
  journeyId         String
  routeId           String?
  routeSegmentId    String?
  type              String
  severity          String
  lat               Float
  lng               Float
  description       String
  source            String
  sourceUrl         String?
  confidence        String   @default("MEDIUM")
  distanceFromRoute Float?
  reportedAt        DateTime
  expiresAt         DateTime?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  journey           Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  route             Route?   @relation(fields: [routeId], references: [id])
  routeSegment      RouteSegment? @relation(fields: [routeSegmentId], references: [id])
}

model CommunityReport {
  id                 String   @id @default(cuid())
  userId             String?
  journeyId          String?
  lat                Float
  lng                Float
  locationName       String?
  category           String
  content            String
  imageUrl           String?
  verificationStatus String   @default("REPORTED")
  confirmationCount  Int      @default(0)
  usefulCount        Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User?    @relation(fields: [userId], references: [id])
  journey            Journey? @relation(fields: [journeyId], references: [id])
  confirmations      ReportConfirmation[]
  comments           Comment[]
  votes              ReportVote[]
}

model ReportConfirmation {
  id        String   @id @default(cuid())
  reportId  String
  userId    String
  createdAt DateTime @default(now())

  report    CommunityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id])

  @@unique([reportId, userId])
}

model Comment {
  id        String   @id @default(cuid())
  reportId  String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  report    CommunityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id])
}

model ReportVote {
  id        String   @id @default(cuid())
  reportId  String
  userId    String
  isUseful  Boolean
  createdAt DateTime @default(now())

  report    CommunityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id])

  @@unique([reportId, userId])
}

model HistoricalIncident {
  id             String   @id @default(cuid())
  location       String
  lat            Float
  lng            Float
  incidentType   String
  weatherContext String?  // JSON stored as string for SQLite
  severity       String
  occurredAt     DateTime
  resolvedAt     DateTime?
  description    String
  source         String
  sourceUrl      String?
  createdAt      DateTime @default(now())
}

model DataSourceRecord {
  id          String   @id @default(cuid())
  journeyId   String
  source      String
  dataType    String
  fetchedAt   DateTime @default(now())
  expiresAt   DateTime
  isStale     Boolean  @default(false)
  reliability Float    @default(0.8)
  rawData     String?  // JSON stored as string for SQLite

  journey     Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
}

model SavedJourney {
  id        String   @id @default(cuid())
  userId    String
  journeyId String
  savedAt   DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@unique([userId, journeyId])
}
